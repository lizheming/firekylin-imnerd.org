<% if (firekylin.post.user) { %><section class="author-card flex items-center my-4 p-4 bg-tertiary-bg rounded"><div class="author-avatar"><%~ include('../fontawesome', {icon: 'user', className: ''}) %></div><div><small>本文作者</small><strong><a href="/author/<%= firekylin.post.user.name %>"><%= firekylin.post.user.display_name || firekylin.post.user.name %></a></strong><p>发布于 <%= firekylin.archive.date('YYYY-MM-DD') %>，最后更新于 <%= firekylin.think.datetime(firekylin.post.update_time, 'YYYY-MM-DD') %></p></div></section><% } %>
