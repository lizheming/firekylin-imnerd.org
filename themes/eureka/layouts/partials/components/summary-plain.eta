<article class="px-2 py-6">
  <div class="flex flex-col-reverse lg:flex-row justify-between">
    <div class="w-full<%= firekylin.archive.row.featuredImage ? ' lg:w-2/3' : '' %>">
      <div class="mb-4"><a href="<%= firekylin.archive.permalink %>" class="font-bold text-xl hover:text-eureka"><%= firekylin.archive.title() %></a></div>
      <div class="content"><p><%= firekylin.archive.excerpt(220, '…') %></p><p class="more"><a href="<%= firekylin.archive.permalink %>">阅读全文 <span class="meta-nav">→</span></a></p></div>
      <div class="flex flex-wrap flex-row items-center my-2 text-tertiary-text text-sm">
        <div class="mr-6 my-2"><%~ include('../fontawesome', {icon: 'calendar', className: 'mr-1'}) %><span><%= firekylin.archive.date('YYYY-MM-DD') %></span></div>
        <div class="mr-6 my-2"><a href="<%= firekylin.archive.permalink %>#comments"><%~ include('../fontawesome', {icon: 'comment', className: 'mr-1'}) %><%= firekylin.archive.commentsNum('暂无评论','%d 条评论') %></a></div>
      </div>
    </div>
    <% if (firekylin.archive.row.featuredImage) { %><div class="w-full lg:w-1/3 mb-4 lg:mb-0 lg:ml-8"><a href="<%= firekylin.archive.permalink %>"><img src="<%= firekylin.archive.row.featuredImage %>" class="w-full" alt="Featured Image" loading="lazy" decoding="async"></a></div><% } %>
  </div>
</article>
