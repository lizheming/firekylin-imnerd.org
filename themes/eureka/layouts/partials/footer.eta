  <% if (firekylin.site.row.miitbeian) { %><p class="text-sm text-tertiary-text"><a href="https://beian.miit.gov.cn" target="_blank" rel="nofollow"><%= firekylin.site.row.miitbeian %></a></p><% } %>
</div>
