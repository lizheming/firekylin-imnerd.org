<nav class="flex items-center justify-between flex-wrap px-4 py-4 md:py-0">
  <a href="/" class="mr-6 text-primary-text text-xl font-bold"><%= firekylin.themeConfig.headerTitle || firekylin.site.title() %></a>
  <button class="nav-toggle md:hidden flex items-center px-3 py-2" type="button" aria-label="展开导航" aria-controls="nav-panel" aria-expanded="false">
    <%~ include('./fontawesome', {icon: 'bars', className: ''}) %>
  </button>
  <div id="nav-panel" class="nav-panel hidden md:flex md:flex-grow md:justify-between md:items-center w-full md:w-auto text-primary-text z-20">
    <div class="nav-links md:flex md:h-16 text-sm md:flex-grow pb-4 md:pb-0 border-b md:border-b-0">
      <% firekylin.site.navigation.forEach(nav => { %><a href="<%= nav.url %>" class="block mt-4 md:inline-block md:mt-0 md:h-(16-4px) md:leading-(16-4px) box-border md:border-t-2 md:border-b-2 border-transparent mr-4"><%= nav.label %></a><% }) %>
    </div>
    <div class="nav-actions flex items-center">
      <div class="search-container relative pt-4 md:pt-0">
        <div class="search">
            <form role="search" class="search-form" action="/search.html" method="get" role="search">
            <label>
                <input name="keyword" type="text" placeholder="搜索 ..." aria-label="搜索" class="search-field">
            </label>
            <button>
                <%~ include('./fontawesome', {icon: 'search', className: ''}) %>
            </button>
            </form>
        </div>
      </div>
    
      <button id="color-mode" class="icon-button relative pl-4 pt-4 md:pt-0" type="button" aria-label="切换明暗模式"><%~ include('./fontawesome', {icon: 'adjust', className: ''}) %></button>
      <a class="icon-button relative pl-4 pt-4 md:pt-0" href="/rss.html" aria-label="RSS"><%~ include('./fontawesome', {icon: 'rss', className: ''}) %></a>
    </div>
  </div>
</nav>
