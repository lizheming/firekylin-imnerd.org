<%
function pageUrl(page) {
  const url = new URL(firekylin.ctx.url, 'http://firekylin.local');
  if (page <= 1) url.searchParams.delete('page');
  else url.searchParams.set('page', page);
  return url.pathname + url.search;
}
const current = Number(firekylin.pagination.currentPage) || 1;
const total = Number(firekylin.pagination.totalPages) || 1;
const pages = [];
for (let page = 1; page <= total; page++) {
  if (page === 1 || page === total || Math.abs(page - current) <= 2) pages.push(page);
}
%>
<% if (total > 1) { %><nav aria-label="分页导航">
  <ul class="pagination">
    <li class="page-item<%= current === 1 ? ' disabled' : '' %>"><% if (current > 1) { %><a class="page-link" href="<%= pageUrl(1) %>" aria-label="第一页">«</a><% } else { %><span class="page-link" aria-hidden="true">«</span><% } %></li>
    <li class="page-item<%= current === 1 ? ' disabled' : '' %>"><% if (current > 1) { %><a class="page-link" href="<%= pageUrl(current - 1) %>" aria-label="上一页">‹</a><% } else { %><span class="page-link" aria-hidden="true">‹</span><% } %></li>
    <% let previous = 0; pages.forEach(page => { %>
      <% if (previous && page - previous > 1) { %><li class="page-item disabled"><span class="page-link pagination-ellipsis">…</span></li><% } %>
      <li class="page-item<%= page === current ? ' active' : '' %>"><% if (page === current) { %><span class="page-link" aria-current="page"><%= page %></span><% } else { %><a class="page-link" href="<%= pageUrl(page) %>"><%= page %></a><% } %></li>
    <% previous = page; }) %>
    <li class="page-item<%= current === total ? ' disabled' : '' %>"><% if (current < total) { %><a class="page-link" href="<%= pageUrl(current + 1) %>" aria-label="下一页">›</a><% } else { %><span class="page-link" aria-hidden="true">›</span><% } %></li>
    <li class="page-item<%= current === total ? ' disabled' : '' %>"><% if (current < total) { %><a class="page-link" href="<%= pageUrl(total) %>" aria-label="最后一页">»</a><% } else { %><span class="page-link" aria-hidden="true">»</span><% } %></li>
  </ul>
</nav><% } %>
