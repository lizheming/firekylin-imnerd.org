<% layout('./layout') %>
<% const archive = await firekylin.widget('Widget_Archive', {type: 'index'}); const site = await firekylin.widget('Widget_Options'); %>
<% block('title', () => { %><% if (archive.is('tag')) { %>标签：<%= archive.archiveTitle %> - <% } else if (archive.is('cate')) { %>分类：<%= archive.archiveTitle %> - <% } %><%= site.title() %><% }) %>
<% block('headers', () => { %><link rel="canonical" href="<%= site.siteUrl + firekylin.ctx.url %>"><% }) %>
<% await blockAsync('content', async () => { %>
  <% if (archive.is('tag') || archive.is('cate')) { %><header class="page-heading"><p class="eyebrow"><%= archive.is('tag') ? '标签' : '分类' %></p><h1><%= archive.archiveTitle %></h1></header><% } %>
  <% if (!archive.is('tag') && !archive.is('cate')) { const recent = await firekylin.widget('Widget_Contents_Post_Recent@eureka-sidebar', {pageSize: 5}); %>
  <div class="grid grid-cols-2 lg:grid-cols-8 gap-4 lg:pt-12" style="padding-top:2rem!important">
    <aside class="col-span-2 sidebar">
      <section class="widget bg-secondary-bg rounded p-6"><h2 class="widget-title">最新文章</h2><ul class="widget-list"><% while (recent.next()) { %><li><a href="<%= recent.permalink %>" class="nav-link"><%= recent.title() %></a></li><% } %></ul></section>
      <section class="widget bg-secondary-bg rounded p-6"><h2 class="widget-title">最近回复</h2><ul class="widget-list recentcomments" id="recent-comments" data-api="<%= site.themeConfig.recentCommentsApi || '' %>"><li class="muted"><%= site.themeConfig.recentCommentsApi ? '正在加载…' : '尚未配置最近回复 API' %></li></ul></section>
      <% if (site.themeConfig.friendLinks) { %><section class="widget bg-secondary-bg rounded p-6"><h2 class="widget-title">友情链接</h2><ul class="widget-list"><%~ site.themeConfig.friendLinks %></ul></section><% } %>
      <section class="widget bg-secondary-bg rounded p-6"><h2 class="widget-title">管理</h2><ul class="widget-list"><li><a href="/admin">🛠 后台管理</a></li><% if (site.themeConfig.recentCommentsApi) { const commentAdmin = site.themeConfig.recentCommentsApi.replace(/\/api\/.*$/, '/ui'); %><li><a href="<%= commentAdmin %>">💬 评论管理</a></li><% } %></ul></section>
    </aside>
    <div class="col-span-2 lg:col-span-6 bg-secondary-bg rounded px-6 py-8"><div class="bg-secondary-bg rounded overflow-hidden px-4 divide-y"><% while (archive.next()) { %><%~ include('./layouts/partials/components/summary-plain', {archive, spriteUrl: site.themeUrl('res/fontawesome/all.svg')}) %><% } %></div><%~ include('./inc/pagination', {pagination: archive.pagination}) %></div>
  </div>
  <% } else { %><section class="bg-secondary-bg rounded overflow-hidden px-4 divide-y"><% while (archive.next()) { %><%~ include('./layouts/partials/components/summary-plain', {archive, spriteUrl: site.themeUrl('res/fontawesome/all.svg')}) %><% } %></section><%~ include('./inc/pagination', {pagination: archive.pagination}) %><% } %>
<% }) %>
