</style>
</head>
<body class="flex flex-col min-h-screen">
  <header class="fixed flex items-center w-full min-h-16 pl-scrollbar z-50 bg-secondary-bg shadow-sm"><div class="w-full max-w-screen-xl mx-auto"><%~ include('./layouts/partials/header', {site, themeConfig, spriteUrl: site.themeUrl('res/fontawesome/all.svg')}) %></div></header>
  <main class="flex-grow pt-16"><div class="pl-scrollbar"><div class="w-full max-w-screen-xl lg:px-4 xl:px-8 mx-auto"><%~ block('content') %></div></div></main>
  <footer class="pl-scrollbar"><div class="w-full max-w-screen-xl mx-auto"><%~ include('./layouts/partials/footer', {site, themeConfig}) %></div></footer>
  <script src="<%= site.themeUrl('res/js/eureka.js') %>"></script>
  <% if (site.row.analyze_code) { %><%~ site.row.analyze_code %><% } %>
  <% if (themeConfig.customJS) { %><script><%~ themeConfig.customJS %></script><% } %>
</body>
</html>
