<% layout('../layout') %>
<%
const archive = await firekylin.widget('Widget_Archive_Eureka', {type: 'page'});
const slides = await firekylin.widget('Widget_Custom_Slides', {
  page: firekylin.ctx.query.page,
  pageSize: 12
});
const site = await firekylin.widget('Widget_Options');
archive.next();
const page = archive.row;
%>

<% block('title', () => { %><%= archive.have() ? archive.title() : '页面未找到' %> - <%= site.title() %><% }) %>
<% block('headers', () => { %><% if (archive.have()) { %><link rel="canonical" href="<%= site.siteUrl + archive.permalink %>"><% } %><% }) %>

<% block('content', () => { %>
<% if (archive.have()) { %>
<style>
  .slides-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .slide-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border-radius: .5rem;
    background: var(--color-secondary-bg);
    color: var(--color-primary-text);
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .slide-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, .16);
  }
  .slide-cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg);
  }
  .slide-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
  }
  .slide-card:hover .slide-cover img { transform: scale(1.04); }
  .slide-info { padding: 1rem; }
  .slide-title {
    margin: 0;
    overflow: hidden;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .slide-time {
    display: block;
    margin-top: .5rem;
    color: var(--color-tertiary-text);
    font-size: .875rem;
  }
  @media (max-width: 1024px) { .slides-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .slides-grid { grid-template-columns: minmax(0, 1fr); } }
</style>

<div class="grid grid-cols-2 lg:grid-cols-8 gap-4 lg:pt-12">
  <article class="col-span-2 lg:col-start-2 lg:col-span-6 bg-secondary-bg rounded px-6 py-8">
    <h1 class="font-bold text-3xl text-primary-text"><%= archive.title() %></h1>
    <div class="flex flex-wrap flex-row items-center my-2 text-tertiary-text">
      <div class="mr-6 my-2">
        <%~ include('../layouts/partials/fontawesome', {icon: 'calendar', className: 'mr-1'}) %>
        <span><%= archive.date((site.themeConfig && site.themeConfig.dateFormat) || 'YYYY-MM-DD') %></span>
      </div>
    </div>
    <% if (page.featuredImage) { %><div class="my-4"><img class="w-full entered" src="<%= page.featuredImage %>" alt=""></div><% } %>
    <div class="content"><%~ archive.content() %></div>

    <% if (slides.have()) { %>
    <div class="slides-grid">
      <% while (slides.next()) { %>
      <a class="slide-card" href="<%= slides.url %>" target="_blank" rel="noopener noreferrer">
        <div class="slide-cover"><img src="<%= slides.image %>" alt="<%= slides.name %>" loading="lazy" decoding="async"></div>
        <div class="slide-info">
          <h2 class="slide-title" title="<%= slides.name %>"><%= slides.name %></h2>
          <% if (slides.time) { %><time class="slide-time" datetime="<%= slides.time %>"><%= slides.time %></time><% } %>
        </div>
      </a>
      <% } %>
    </div>
    <% } else { %>
      <p class="muted"><%= slides.error ? '演示文稿数据加载失败。' : '暂无演示文稿。' %></p>
    <% } %>

    <%~ include('../inc/pagination', {pagination: slides.pagination}) %>
  </article>
</div>
<% } else { %>
<article class="article-card page-card"><h1>页面未找到</h1><div class="content"><p>没有找到这个页面。</p></div></article>
<% } %>
<% }) %>
