{
  "name": "firekylin-blog",
  "env": {
    "NODE_OPTIONS": "--experimental-require-module"
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": ".vercel-static"
      }
    },
    {
      "src": "main.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "firekylin.config.js",
          "data/**",
          "themes/**",
          "uploads/**",
          "widgets/**",
          "node_modules/mhchemparser/**/*",
          "node_modules/@mathjax/mathjax-newcm-font/**/*"
        ]
      }
    },
    {
      "src": "themes/**/*.{css,eot,gif,ico,jpeg,jpg,js,png,svg,ttf,webp,woff,woff2}",
      "use": "@vercel/static"
    },
    {
      "src": "uploads/**",
      "use": "@vercel/static"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/main.js"
    }
  ],
  "crons": [
    {
      "path": "/admin/cron/rss",
      "schedule": "0 0 * * *"
    }
  ],
  "github": {
    "silent": true
  }
}
